{
  "name": "cryptotrace-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CryptoTrace — Real-time identification of fraud-linked cryptocurrency exchanges. Phases 1-3: blockchain ingestion, Neo4j graph persistence, and shortestPath cash-out tracing.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:fixtures": "node scripts/generate-fixtures.js",
    "seed:exchanges": "node scripts/seed-exchanges.js",
    "seed:admin": "node scripts/seed-admin.js",
    "smoke": "node scripts/smoke.js",
    "smoke:graph": "node scripts/smoke-graph.js",
    "smoke:trace": "node scripts/smoke-trace.js",
    "verify": "npm run smoke && npm run smoke:graph && npm run smoke:trace",
    "test": "npm run test:auth && npm run test:trace && npm run test:services",
    "test:auth": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/auth.routes.test.js --runInBand",
    "test:trace": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/trace.routes.test.js tests/tracePipeline.integration.test.js tests/correlate.test.js --runInBand",
    "test:services": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/btcClustering.service.unit.test.js tests/btcIngestion.service.unit.test.js tests/btcTrace.service.unit.test.js tests/sanctions.service.unit.test.js tests/sanctions.coldstart.test.js tests/riskEngine.test.js --runInBand",
    "test:security": "node scripts/test-security.js",
    "test:load": "node scripts/load-test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "neo4j-driver": "^5.28.1",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
