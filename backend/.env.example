# ---------------------------------------------------------------------------
# CryptoTrace backend - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The Phase 4 Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Blockchain RPC -------------------------------------------------------
# Your Alchemy API key (dashboard.alchemy.com -> your app -> API Key).
# Only the key is needed; the full URL is assembled from ALCHEMY_NETWORK.
ALCHEMY_API_KEY=

# Alchemy network slug. Must be a network that supports the
# `alchemy_getAssetTransfers` enhanced API.
#   eth-mainnet | eth-sepolia | polygon-mainnet | base-mainnet | arb-mainnet
ALCHEMY_NETWORK=eth-mainnet

# Optional: override the whole RPC URL (e.g. to point at Infura or a local
# archive node). If set, this takes precedence over the two vars above.
# RPC_URL=

# --- Ingestion tuning -----------------------------------------------------
# Default traversal depth (hops) when the caller does not specify one.
# Phase 1 testing target is 3. Guard rail below caps what a caller may ask for.
DEFAULT_TRACE_DEPTH=3
MAX_TRACE_DEPTH=5

# Per-address fan-out cap. At each hop we follow only the N largest outgoing
# transfers. Without this, one brush against a high-traffic wallet explodes the
# frontier into tens of thousands of addresses and burns your Alchemy quota.
MAX_FANOUT_PER_ADDRESS=12

# Maximum transfers pulled per address (across pagination pages).
MAX_TRANSFERS_PER_ADDRESS=250

# Hard ceiling on total addresses expanded in a single trace. Circuit breaker.
MAX_ADDRESSES_PER_TRACE=400

# Ignore transfers below these thresholds. Dust/spam transfers are a common
# obfuscation and pollution vector; filtering them keeps the graph legible.
MIN_NATIVE_VALUE=0.001
MIN_STABLE_VALUE=1

# Approximate USD value of one native coin, used wherever the system has to
# compare two amounts in DIFFERENT assets. There are three such places:
#   1. ranking outgoing branches when applying the fan-out cap, so 0.4 ETH is
#      correctly ranked above 100 USDT (Phase 1);
#   2. breaking ties between two cash-out routes of equal hop length, so
#      12 ETH outranks 32,500 USDT instead of the other way round (Phase 3);
#   3. sizing nodes and edges in the force-graph payload (Phase 3).
#
# Stablecoins are taken as 1 USD; everything else is multiplied by this number.
# It is deliberately crude - there is no price oracle - and it is NEVER used in a
# reported amount, so a ballpark figure is fine. Every value derived from it is
# named `...UsdApprox` to make that visible in the API response.
NATIVE_USD_HINT=3000

# How many RPC calls may be in flight at once. Alchemy free tier is ~330 CU/s
# and getAssetTransfers costs 150 CU, so keep this low on the free tier.
RPC_CONCURRENCY=4

# Retry policy for rate-limited / transient RPC failures.
RPC_MAX_RETRIES=5
RPC_BASE_BACKOFF_MS=400

# Include contract-initiated (internal) transfers. These matter for tracing
# through routers, proxies and mixers, but the `internal` category requires
# Alchemy's trace API (paid tiers) on mainnet. Leave false on the free tier.
INCLUDE_INTERNAL_TRANSFERS=false

# --- Neo4j graph database (Phase 2) ---------------------------------------
# Master switch. Set to false to run the ingestion service with no database at
# all: traces still work and still identify exchanges, they just are not saved.
# Useful if Neo4j will not start and you need a working demo in five minutes.
GRAPH_ENABLED=true

# Bolt connection URI.
#
# IMPORTANT: this is port 7687 (Bolt), NOT 7474. 7474 is the Neo4j Browser web
# interface. Pointing this at 7474 is the single most common first-run mistake,
# so the config validator checks for it explicitly and tells you.
#
#   Neo4j Desktop (local DBMS)  neo4j://localhost:7687
#   Neo4j Aura (managed cloud)  neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687

# Credentials. The default user is `neo4j`; the password is whatever you set when
# creating the DBMS in Neo4j Desktop.
#
# Required whenever GRAPH_ENABLED=true. The service refuses to start without it
# rather than failing later on the first query. It is never logged, never
# returned by /api/config, and never masked-with-length either.
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Target database inside the DBMS. Neo4j Community Edition only supports the
# default `neo4j` database, so leave this alone unless you are on Enterprise.
NEO4J_DATABASE=neo4j

# Rows per write transaction. A wide trace produces thousands of edges; batching
# keeps the round-trip count low while bounding transaction size so the undo log
# does not exhaust Neo4j's default heap.
GRAPH_BATCH_SIZE=500

# Create the constraints and indexes automatically at boot and before each
# ingest. Cheap (IF NOT EXISTS) and easy to forget, so on by default. Without the
# uniqueness constraint on Wallet.address every MERGE degrades to a label scan.
GRAPH_AUTO_MIGRATE=true

# Connection pool and timeout tuning. The defaults are fine for local work.
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_MS=5000
NEO4J_MAX_TX_RETRY_MS=15000

# --- Demo safety ----------------------------------------------------------
# When true, the service serves recorded fixture data from ./fixtures instead
# of calling Alchemy. Use this if venue wifi dies or you exhaust your quota
# mid-presentation. No API key required in this mode.
#
# Note that MOCK_MODE affects only the blockchain half. Fixture traces are still
# written to Neo4j, so the graph demo works fully offline too.
MOCK_MODE=false
